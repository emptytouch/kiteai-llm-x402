# Kite wallet that RECEIVES payments.
# Must match the address you registered on the KiteAI Bounty Dashboard.
PAY_TO=0x9e610Cd701472bF7C815a6404B6ff88D81838C91

# Kite network: mainnet | testnet
KITE_NETWORK=testnet

# Groq API key (free tier, no credit card): https://console.groq.com/keys
GROQ_API_KEY=

# Price charged per chat completion, in USD
PRICE_USD=0.001

# HTTP port (Render ignores this and sets its own)
PORT=8080

# Optional: override the x402 facilitator (default https://facilitator.pieverse.io/v2)
# FACILITATOR_URL=
