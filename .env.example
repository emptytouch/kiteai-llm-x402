# Kite wallet that RECEIVES payments.
# Must match the address you registered on the KiteAI Bounty Dashboard.
PAY_TO=0x9e610Cd701472bF7C815a6404B6ff88D81838C91

# Kite network: mainnet | testnet
KITE_NETWORK=testnet

# Upstream LLM — OpenAI-compatible. Defaults to SiliconFlow (card-free, free quota).
# Get a free key at https://siliconflow.cn (or point at Groq / OpenRouter / Ollama).
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3-8B

# Price charged per chat completion, in USD (standard tier)
PRICE_USD=0.001

# Pro tier: higher-priced endpoint routed to a heavier reasoning model
PRICE_USD_PRO=0.01
LLM_MODEL_PRO=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B

# HTTP port (Render ignores this and sets its own)
PORT=8080

# Optional: override the x402 facilitator (default https://facilitator.pieverse.io/v2)
# FACILITATOR_URL=
